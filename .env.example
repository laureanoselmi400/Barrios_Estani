# --- Base de datos (Neon en producción) ---
# En Neon copiá la connection string "Pooled" (para la app) y "Direct" (para migraciones).
# Local con Docker: postgresql://postgres:postgres@localhost:5432/barriostreet?schema=public
# (DIRECT_URL igual a DATABASE_URL si no usás pooling).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Cloudinary (subida de imágenes) ---
# Podés usar CLOUDINARY_URL (una sola línea) o las tres claves por separado.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Carpeta dentro de tu cuenta donde se guardan las imágenes (opcional)
CLOUDINARY_FOLDER="barrio-street"

# --- URL pública del sitio (para back_urls y webhooks) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin ---
ADMIN_EMAIL="admin@barriostreet.co"
ADMIN_PASSWORD="cambiar-esta-clave"
# Generar con: openssl rand -base64 32
AUTH_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"

# --- Mercado Pago (Checkout Pro) ---
MP_ACCESS_TOKEN=""
# Opcional pero recomendado: clave secreta de webhooks (Tus integraciones > Webhooks)
MP_WEBHOOK_SECRET=""

# --- GO Cuotas ---
GOCUOTAS_API_URL="https://sandbox.gocuotas.com"
GOCUOTAS_EMAIL=""
GOCUOTAS_PASSWORD=""

# --- WhatsApp (formato internacional sin + ni espacios) ---
NEXT_PUBLIC_WHATSAPP_NUMBER="5492477698738"
