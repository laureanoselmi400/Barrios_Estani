// BARRIO STREET — esquema de datos
// Para desarrollo local con SQLite: cambiar provider a "sqlite" y
// DATABASE_URL a "file:./dev.db". No se usan enums ni arrays nativos
// para que el esquema sea portable entre ambos motores. Los valores
// válidos (género, categoría, estado) se validan con zod en src/lib/constants.ts.
// Nota: el filtro de búsqueda usa `mode: "insensitive"` (solo PostgreSQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: DATABASE_URL apunta a la conexión *pooled* (pgbouncer) para la app
  // serverless; DIRECT_URL a la conexión directa que usan las migraciones.
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  price       Int // precio original en ARS (enteros)
  salePrice   Int? // precio promocional opcional
  gender      String // HOMBRE | MUJER | UNISEX
  category    String // REMERAS | PANTALONES | SACOS | ABRIGOS | CALZADO | ACCESORIOS
  views       Int      @default(0) // contador automático de visitas
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images ProductImage[]
  sizes  ProductSize[]

  @@index([gender, category])
  @@index([views])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSize {
  id        String  @id @default(cuid())
  label     String // "1", "2", "3", "S", "M", "L", "XL", "40"...
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
}

model Order {
  id              String      @id @default(cuid())
  status          String      @default("PENDING") // PENDING | PAID | REJECTED | CANCELLED
  paymentMethod   String // MERCADOPAGO | GOCUOTAS
  total           Int
  buyerName       String
  buyerEmail      String
  buyerPhone      String
  shippingAddress String?
  externalId      String? // id de preferencia / checkout / pago en la pasarela
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  title     String
  size      String
  unitPrice Int
  quantity  Int
  image     String?
}
